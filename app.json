{
  "expo": {
    "name": "StockPulse",
    "slug": "stockpulse",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stockpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ch.tks-group.stockpulse",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow StockPulse to access your camera to scan POS receipts, goods delivery slips, and supplier invoices.",
        "NSPhotoLibraryUsageDescription": "Allow StockPulse to access your photo library to import receipt and invoice photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.stockpulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "stockpulse",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockPulse to access your camera to scan POS receipts, goods delivery slips, and supplier invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StockPulse to access your photo library to import receipt and invoice photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5dd8ffd-277b-4716-aab1-2a5db27a3175"
      }
    }
  }
}
