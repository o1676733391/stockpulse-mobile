# StockPulse Mobile App - Environment Configuration

# Backend REST API URL
# For Android Emulator: Use http://10.0.2.2:5000/api/v1
# For iOS Simulator / Web: Use http://localhost:5000/api/v1
# For Physical Device: Use your computer's local LAN IP (e.g. http://192.168.1.100:5000/api/v1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1

# Fallback to mock data if backend server is unreachable
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Debug logging for API requests and fallbacks
EXPO_PUBLIC_DEBUG_API=true
