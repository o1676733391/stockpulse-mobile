# Server Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# Supabase Managed Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OCR Agent & Gemini Configuration (Primary Multilingual Provider)
OCR_DEFAULT_PROVIDER=gemini_vision
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud Platform & Document AI (Optional / Secondary Provider)
GCP_PROJECT_ID=stockpulse-prod
GCP_LOCATION=us-central1
GCP_DOCAI_PROCESSOR_ID=your-processor-id
GOOGLE_APPLICATION_CREDENTIALS=

# Stripe Billing & Metered Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry APM Monitoring
SENTRY_DSN=
